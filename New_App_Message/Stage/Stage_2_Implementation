# Hướng dẫn Triển khai Giai đoạn 2: Thiết kế Database (Models) cho Chat

Giai đoạn này chúng ta sẽ thiết kế 2 bảng trong cơ sở dữ liệu để lưu trữ thông tin về Cuộc trò chuyện (Conversation) và Tin nhắn (Message).

---

## Bước 1: Mở file `models.py` của app `chat`

Bạn hãy mở file `chat/models.py` lên (xóa hết nội dung cũ mặc định nếu có) và copy - dán toàn bộ đoạn code dưới đây vào:

```python
import uuid
from django.db import models
from accounts.models import User
from music.models import Song, Album
from playlists.models import Playlist
from music_platform.utils import optimize_cloudinary_url

class Conversation(models.Model):
    """
    Lưu trữ thông tin cuộc trò chuyện giữa 2 (hoặc nhiều) người.
    Trong phạm vi ứng dụng chat 1-1, số lượng participants thường là 2.
    """
    id = models.UUIDField(primary_key=True, default=uuid.uuid4, editable=False)
    participants = models.ManyToManyField(User, related_name='conversations', verbose_name='Người tham gia')
    
    created_at = models.DateTimeField(auto_now_add=True, verbose_name='Ngày tạo')
    updated_at = models.DateTimeField(auto_now=True, verbose_name='Cập nhật lần cuối')

    class Meta:
        db_table = 'chat_conversation'
        verbose_name = 'Cuộc trò chuyện'
        verbose_name_plural = 'Cuộc trò chuyện'
        ordering = ['-updated_at']

    def __str__(self):
        return f"Conversation {self.id}"

    def to_dict(self, viewer=None):
        """
        Serialize Conversation thành dict.
        viewer: truyền vào User hiện tại để tự động lấy ra người kia (other_user).
        """
        data = {
            'id': str(self.id),
            'created_at': self.created_at.isoformat(),
            'updated_at': self.updated_at.isoformat(),
        }
        
        # Nếu biết ai đang xem, tìm người còn lại trong cuộc trò chuyện
        if viewer:
            other_participants = self.participants.exclude(id=viewer.id)
            if other_participants.exists():
                other = other_participants.first()
                data['other_user'] = other.to_dict()
                
        return data


class Message(models.Model):
    """
    Lưu trữ thông tin chi tiết của 1 tin nhắn.
    Bao gồm text, ảnh, bài hát chia sẻ và thả tim (reactions).
    """
    id = models.UUIDField(primary_key=True, default=uuid.uuid4, editable=False)
    conversation = models.ForeignKey(
        Conversation, 
        on_delete=models.CASCADE, 
        related_name='messages',
        verbose_name='Cuộc trò chuyện'
    )
    sender = models.ForeignKey(
        User, 
        on_delete=models.SET_NULL, 
        null=True,
        verbose_name='Người gửi'
    )
    
    # Nội dung text (có thể rỗng nếu chỉ gửi ảnh/nhạc)
    content = models.TextField(blank=True, default='', verbose_name='Nội dung')
    
    # URL ảnh được lưu trên Cloudinary
    image_url = models.URLField(blank=True, null=True, verbose_name='Ảnh đính kèm')
    
    # Chia sẻ Bài hát, Album, Playlist
    shared_song = models.ForeignKey(
        Song, 
        on_delete=models.SET_NULL, 
        null=True, 
        blank=True,
        verbose_name='Bài hát chia sẻ'
    )
    shared_album = models.ForeignKey(
        Album,
        on_delete=models.SET_NULL,
        null=True,
        blank=True,
        related_name='shared_in_messages',
        verbose_name='Album chia sẻ'
    )
    shared_playlist = models.ForeignKey(
        Playlist,
        on_delete=models.SET_NULL,
        null=True,
        blank=True,
        related_name='shared_in_messages',
        verbose_name='Playlist chia sẻ'
    )
    
    # Lưu danh sách thả cảm xúc dưới dạng JSON dict (vd: {"user_id_1": "❤️", "user_id_2": "😂"})
    reactions = models.JSONField(default=dict, blank=True, verbose_name='Cảm xúc')
    
    # Trạng thái đã xem tin nhắn hay chưa
    is_read = models.BooleanField(default=False, verbose_name='Đã xem')
    
    created_at = models.DateTimeField(auto_now_add=True, db_index=True, verbose_name='Ngày gửi')

    class Meta:
        db_table = 'chat_message'
        verbose_name = 'Tin nhắn'
        verbose_name_plural = 'Tin nhắn'
        ordering = ['created_at']  # Xếp tin cũ lên trên, tin mới ở dưới

    def __str__(self):
        return f"Message {self.id} by {self.sender}"

    def to_dict(self):
        """Serialize Message thành dict cho API."""
        data = {
            'id': str(self.id),
            'conversation_id': str(self.conversation_id),
            'sender': self.sender.to_dict() if self.sender else None,
            'content': self.content,
            'image_url': optimize_cloudinary_url(self.image_url, 'image') if self.image_url else None,
            'reactions': self.reactions,
            'is_read': self.is_read,
            'created_at': self.created_at.isoformat(),
        }
        
        # Gắn dữ liệu bài hát, album, playlist nếu có
        if self.shared_song:
            data['shared_song'] = {
                'id': str(self.shared_song.id),
                'title': self.shared_song.title,
                'cover_image': optimize_cloudinary_url(self.shared_song.cover_image, 'image') if self.shared_song.cover_image else None,
                'artist_name': self.shared_song.artist.display_name if getattr(self.shared_song, 'artist', None) else None,
            }
        
        if self.shared_album:
            data['shared_album'] = {
                'id': str(self.shared_album.id),
                'title': self.shared_album.title,
                'cover_image': optimize_cloudinary_url(self.shared_album.cover_image, 'image') if self.shared_album.cover_image else None,
            }
            
        if self.shared_playlist:
            data['shared_playlist'] = {
                'id': str(self.shared_playlist.id),
                'title': self.shared_playlist.title,
                'cover_image': optimize_cloudinary_url(self.shared_playlist.cover_image, 'image') if self.shared_playlist.cover_image else None,
            }

        return data
```

## Bước 2: Đăng ký vào Admin Panel

Để có thể dễ dàng quản lý Cuộc trò chuyện và Tin nhắn trên trang Admin của Django, bạn hãy mở file `chat/admin.py` lên (xóa hết nội dung mặc định) và dán đoạn code sau vào:

```python
from django.contrib import admin
from .models import Conversation, Message

class MessageInline(admin.TabularInline):
    """Giúp hiển thị các tin nhắn ngay bên trong trang chi tiết của Cuộc trò chuyện"""
    model = Message
    extra = 0
    readonly_fields = ('id', 'created_at')

@admin.register(Conversation)
class ConversationAdmin(admin.ModelAdmin):
    list_display = ('id', 'created_at', 'updated_at')
    inlines = [MessageInline]
    filter_horizontal = ('participants',)
    readonly_fields = ('id', 'created_at', 'updated_at')
    search_fields = ('participants__username', 'participants__email')

@admin.register(Message)
class MessageAdmin(admin.ModelAdmin):
    list_display = ('id', 'conversation', 'sender', 'short_content', 'is_read', 'created_at')
    list_filter = ('is_read', 'created_at')
    search_fields = ('content', 'sender__email', 'sender__username')
    readonly_fields = ('id', 'created_at')

    def short_content(self, obj):
        """Cắt ngắn nội dung tin nhắn nếu quá dài để hiển thị gọn trên bảng"""
        if obj.content:
            return obj.content[:50] + '...' if len(obj.content) > 50 else obj.content
        if obj.image_url:
            return '[Hình ảnh]'
        if obj.shared_song:
            return f'[Chia sẻ bài hát: {obj.shared_song.title}]'
        return '[Không có nội dung]'
    short_content.short_description = 'Nội dung'
```

## Bước 3: Tạo và chạy Migration

Sau khi đã lưu file `models.py` và `admin.py` thành công, bạn cần đồng bộ các bảng này vào trong Database.

Mở Terminal của VS Code, kiểm tra chắc chắn đã active môi trường ảo (có chữ `(PlayMood_Project)` ở đầu dòng), rồi lần lượt chạy 2 lệnh sau:

```bash
python manage.py makemigrations chat
python manage.py migrate
```

**Dấu hiệu thành công:** Terminal báo `Migrations for 'chat': ...` và `Applying chat.0001_initial... OK`.

Hãy thao tác copy code và chạy lệnh nhé. Nếu có lỗi cứ copy gửi cho tôi xem, nếu thành công thì báo lại để chúng ta sang Giai đoạn 3!
