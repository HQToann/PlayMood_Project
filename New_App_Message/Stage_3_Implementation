## Bước 5: Định nghĩa Bắt lỗi (`exceptions.py`) & Kiểm tra dữ liệu (`validators.py`)

### 5.1. File `chat/exceptions.py`
Tạo file `exceptions.py` để định nghĩa các lỗi đặc thù cho chức năng Chat, đảm bảo trả về đúng HTTP Status (VD: 403, 404).

```python
from accounts.exceptions import AppException

class ChatException(AppException):
    """Lỗi cơ bản cho module Chat - HTTP 400"""
    def __init__(self, message='Lỗi ứng dụng chat', error_code='CHAT_ERROR'):
        super().__init__(message, error_code=error_code)

class NotFriendsError(AppException):
    """Bắn ra khi 2 người chưa phải là bạn bè (chưa follow 2 chiều) - HTTP 403"""
    def __init__(self, message='Chỉ có thể nhắn tin với bạn bè (yêu cầu follow 2 chiều).'):
        super().__init__(message, error_code='NOT_FRIENDS')

class ConversationNotFoundError(AppException):
    """Bắn ra khi không tìm thấy cuộc trò chuyện hoặc không có quyền truy cập - HTTP 404"""
    def __init__(self, message='Không tìm thấy cuộc trò chuyện hoặc bạn không có quyền xem.'):
        super().__init__(message, error_code='NOT_FOUND')
```

### 5.2. File `chat/validators.py`
Tạo file `validators.py` để làm sạch và kiểm tra dữ liệu tin nhắn trước khi lưu vào Database.

```python
from accounts.exceptions import ValidationError
from music.models import Song, Album
from playlists.models import Playlist

def validate_message_content(content: str, image_url: str, shared_song_id: str, shared_album_id: str = None, shared_playlist_id: str = None):
    """
    Kiểm tra tính hợp lệ của tin nhắn:
    Phải có ít nhất 1 trong các thành phần: text, hình ảnh, hoặc chia sẻ (bài hát/album/playlist).
    """
    if not content and not image_url and not shared_song_id and not shared_album_id and not shared_playlist_id:
        raise ValidationError(
            'Tin nhắn không hợp lệ', 
            fields={'content': ['Tin nhắn phải có nội dung chữ, ảnh hoặc đính kèm']}
        )
    
    if shared_song_id:
        # Kiểm tra xem bài hát có tồn tại không
        if not Song.objects.filter(id=shared_song_id).exists():
            raise ValidationError(
                'Bài hát không hợp lệ',
                fields={'shared_song_id': ['Bài hát đính kèm không tồn tại hoặc đã bị xoá']}
            )
            
    if shared_album_id:
        if not Album.objects.filter(id=shared_album_id).exists():
            raise ValidationError(
                'Album không hợp lệ',
                fields={'shared_album_id': ['Album đính kèm không tồn tại hoặc đã bị xoá']}
            )
            
    if shared_playlist_id:
        if not Playlist.objects.filter(id=shared_playlist_id).exists():
            raise ValidationError(
                'Playlist không hợp lệ',
                fields={'shared_playlist_id': ['Playlist đính kèm không tồn tại hoặc đã bị xoá']}
            )
```

