## Bước 4: Xử lý Modal 2 Lớp (Javascript)

Cuối cùng, trong file `posts.js`, ta viết đoạn mã điều khiển Modal Chia sẻ. Khi bấm "Gửi", ta bắn tín hiệu WebSocket sang hệ thống Chat.

```javascript
// (Đặt code này trong posts.js)

// Biến lưu trữ ID bài viết đang muốn chia sẻ
let currentSharePostId = null; 

// Khi bấm nút "Chia sẻ" trên 1 bài viết -> Lưu ID lại
document.body.addEventListener('click', (e) => {
    if (e.target.closest('.btn-share')) {
        const postCard = e.target.closest('.post-card');
        currentSharePostId = postCard.dataset.postId;
        
        // Chuyển Modal về Lớp 1 (Danh sách bạn bè)
        document.getElementById('shareModalLayer1').style.display = 'block';
        document.getElementById('shareModalLayer2').style.display = 'none';
    }
});

// Khi chọn 1 người bạn (Từ Lớp 1)
document.body.addEventListener('click', (e) => {
    const friendItem = e.target.closest('.share-friend-item');
    if (friendItem) {
        const conversationId = friendItem.dataset.conversationId;
        
        // Lưu thông tin người nhận vào nút Gửi ở Lớp 2
        document.getElementById('btnConfirmShare').dataset.conversationId = conversationId;
        
        // Hiệu ứng chuyển từ Lớp 1 -> Lớp 2 (Slide qua)
        document.getElementById('shareModalLayer1').style.display = 'none';
        document.getElementById('shareModalLayer2').style.display = 'block';
    }
});

// Khi bấm nút "Gửi" cuối cùng (Ở Lớp 2)
document.getElementById('btnConfirmShare').addEventListener('click', function() {
    const conversationId = this.dataset.conversationId;
    const optionalMessage = document.getElementById('shareOptionalMessage').value;
    
    // GỬI QUA WEBSOCKET (Sử dụng lại chatSocket đã có của dự án)
    if (window.chatSocket && window.chatSocket.readyState === WebSocket.OPEN) {
        window.chatSocket.send(JSON.stringify({
            'action': 'send_message',
            'conversation_id': conversationId,
            'message': optionalMessage,
            'shared_post_id': currentSharePostId // 🌟 Biến mới cực quan trọng
        }));
        
        // Đóng Modal, thông báo thành công
        const modal = bootstrap.Modal.getInstance(document.getElementById('sharePostModal'));
        modal.hide();
        alert('Đã gửi bài viết qua tin nhắn!');
        document.getElementById('shareOptionalMessage').value = ''; // Reset ô nhập
    } else {
        alert('Kết nối chat bị gián đoạn!');
    }
});
```

